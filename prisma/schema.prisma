generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Połączenie bez poolera do migracji (Neon/Supabase); lokalnie ten sam adres co DATABASE_URL
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  PRIVATE
  COMPANY
  DEALER
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
  // wstrzymane przez moderację (agent albo administrator), niewidoczne publicznie
  HIDDEN
}

enum SaleType {
  FIXED
  AUCTION
}

enum Condition {
  WORKING
  NEEDS_REPAIR
  DAMAGED
  FOR_PARTS
}

enum AuctionMode {
  // licytację wystawia sprzedawca
  SELLER
  // licytację prowadzi 3core.pl (wadium, opłata aukcyjna)
  HOUSE
}

enum AuctionStatus {
  LIVE
  ENDED
  CANCELLED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  phone        String?
  companyName  String?
  nip          String?
  accountType  AccountType @default(PRIVATE)
  verified     Boolean     @default(false)
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  listings     Listing[]
  favorites    Favorite[]
  bids         Bid[]
  proxyBids    ProxyBid[]
  wonAuctions  Auction[]   @relation("AuctionWinner")
  // ostatnie sprawdzenie NIP w Białej liście VAT
  nipCheckedAt DateTime?
  agentActions AgentAction[] @relation("AgentActionUser")
  decisions    AgentAction[] @relation("AgentActionDecider")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Listing {
  id           String        @id @default(cuid())
  title        String
  category     String
  brand        String
  model        String
  year         Int
  // godziny pracy maszyny (licznik godzin / godziny pod wrzecionem)
  hours        Int?
  keyParam     String?
  // sterowanie CNC, np. Fanuc 0i-TF, Heidenhain TNC 640, Siemens 828D
  controlSystem String?
  // cena stała albo aktualna cena licytacji (aktualizowana przy każdej ofercie)
  priceNet     Int
  vatInvoice   Boolean       @default(true)
  saleType     SaleType      @default(FIXED)
  condition    Condition     @default(WORKING)
  weightKg     Int?
  // dział "Maszyny w cenie złomu": cena za kg nie wyższa niż próg z src/lib/scrap.ts
  scrapPrice   Boolean       @default(false)
  voivodeship  String
  city         String
  description  String
  serialNumber String?
  status       ListingStatus @default(ACTIVE)
  views        Int           @default(0)
  // kiedy agent sprawdził ogłoszenie (null = jeszcze nie sprawdzone)
  moderatedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       Image[]
  favorites    Favorite[]
  auction      Auction?
  agentActions AgentAction[]

  @@index([status, category])
  @@index([status, saleType])
  @@index([status, scrapPrice])
  @@index([status, createdAt])
  @@index([voivodeship])
}

model Image {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model Auction {
  id              String        @id @default(cuid())
  listingId       String        @unique
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mode            AuctionMode   @default(SELLER)
  status          AuctionStatus @default(LIVE)
  startPrice      Int
  // cena minimalna, poniżej której sprzedawca nie musi sprzedać (niewidoczna dla kupujących)
  reservePrice    Int?
  currentPrice    Int
  bidCount        Int           @default(0)
  leaderId        String?
  // opłata aukcyjna doliczana kupującemu, w promilach (50 = 5%); 0 dla aukcji sprzedawców
  buyerPremiumBp  Int           @default(0)
  depositAmount   Int?
  startsAt        DateTime      @default(now())
  endsAt          DateTime
  originalEndsAt  DateTime
  winnerId        String?
  winner          User?         @relation("AuctionWinner", fields: [winnerId], references: [id])
  finalPrice      Int?
  createdAt       DateTime      @default(now())
  bids            Bid[]
  proxyBids       ProxyBid[]

  @@index([status, endsAt])
}

// Widoczna historia licytacji
model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  // oferta złożona automatycznie z limitu (licytacja do kwoty maksymalnej)
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

// Ukryty limit licytującego: system podbija za niego do tej kwoty
model ProxyBid {
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxAmount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([auctionId, userId])
}

// ---------- agent AI ----------

enum AgentActionKind {
  // agent od razu wstrzymał ogłoszenie (oczywisty spam/oszustwo); zatwierdzenie archiwizuje, odrzucenie przywraca
  HIDE_LISTING
  // ogłoszenie do sprawdzenia przez człowieka; zatwierdzenie wstrzymuje ogłoszenie
  FLAG_LISTING
  // propozycja zmiany kategorii; zatwierdzenie ją wprowadza
  CHANGE_CATEGORY
  // firma potwierdzona w Białej liście VAT; zatwierdzenie nadaje odznakę dealera
  VERIFY_COMPANY
  // problem z NIP-em firmy (nie istnieje, nieczynny VAT, inna nazwa)
  FLAG_COMPANY
}

enum AgentActionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Kolejka decyzji agenta do zatwierdzenia w panelu /admin
model AgentAction {
  id          String            @id @default(cuid())
  kind        AgentActionKind
  status      AgentActionStatus @default(PENDING)
  // krótki opis dla administratora i uzasadnienie agenta
  summary     String
  reasoning   String
  // dane potrzebne do wykonania decyzji, np. { category: "tokarki" }
  payload     Json?
  listingId   String?
  listing     Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation("AgentActionUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedById String?
  decidedBy   User?             @relation("AgentActionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
}

// Dziennik wywołań Claude API: koszt i błędy
model AgentRun {
  id           String   @id @default(cuid())
  task         String
  subjectId    String?
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // koszt w mikrodolarach (1 USD = 1 000 000)
  costMicroUsd Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Poranny raport agenta
model AgentReport {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}
