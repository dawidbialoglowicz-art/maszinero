# Baza PostgreSQL (np. Neon). DATABASE_URL: adres z poolerem (dla aplikacji),
# DIRECT_URL: adres bez poolera (dla migracji). Lokalnie oba mogą być takie same.
DATABASE_URL="postgresql://user:password@host:5432/maszinero"
DIRECT_URL="postgresql://user:password@host:5432/maszinero"
# Losowy ciąg min. 32 znaki: openssl rand -base64 32
SESSION_SECRET=""
# Opcjonalnie: Vercel Blob na zdjęcia. Bez tego zdjęcia trafiają do katalog uploads/ (tylko lokalnie).
BLOB_READ_WRITE_TOKEN=""
# Sekret dla zadania cron kończącego aukcje (Vercel ustawia nagłówek Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
